<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Chỉ cho phép HTTPS; không tin chứng chỉ do người dùng tự cài -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
